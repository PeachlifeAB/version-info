# version-info environment variables. Copy to .env and export, or set in your shell.
# version-info reads these at startup; it does not load this file itself.

# Network and command timeout in seconds.
VERSION_INFO_TIMEOUT_S=10

# 1 prints scanner diagnostics to stderr.
VERSION_INFO_VERBOSE=0

# Maximum concurrent registry lookups. --concurrency overrides it.
VERSION_INFO_CONCURRENCY=16

# Optional. Raises GitHub API rate limits; required for Nix and SwiftPM lookups.
# GITHUB_TOKEN=
