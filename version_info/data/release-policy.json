{
	"schemes": {
		"pypi": "pypi",
		"npm": "semver",
		"cargo": "semver",
		"go": "semver",
		"ruby": "ruby",
		"swiftpm": "semver",
		"terraform": "semver",
		"gradle": "gradle"
	},
	"same_release_preview": ["gradle"],
	"respect_reported_latest": ["npm"],
	"gradle": {
		"valid_pattern": "(?ai)^(?!latest)[0-9a-z]+(?:[-._+][0-9a-z]+)*[-._+]?$",
		"part_pattern": "[0-9]+|[A-Za-z]+|(?<=[-._+])$",
		"version_prefix": "v",
		"unstable": [
			"dev",
			"a",
			"alpha",
			"b",
			"beta",
			"m",
			"mt",
			"milestone",
			"rc",
			"cr",
			"preview",
			"snapshot"
		],
		"qualifier_order": {
			"dev": -1,
			"rc": 1,
			"cr": 1,
			"snapshot": 2,
			"final": 3,
			"ga": 4,
			"release": 5,
			"latest": 5,
			"sr": 5,
			"sp": 6
		}
	},
	"compatibility": [
		{
			"ecosystem": "gradle",
			"package": "com.google.guava:guava",
			"pattern": "^[0-9]+(?:\\.[0-9]+)*(?P<compatibility>-[A-Za-z0-9.-]+)?$"
		}
	]
}
